<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewfinder_bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.innovation313.roshancamera.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintTop_toTopOf="@id/preview" />

    <LinearLayout
        android:id="@+id/gpsChip"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_gps_chip_weak"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/gpsDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_status" />

        <TextView
            android:id="@+id/locationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/gps_searching"
            android:textColor="@color/on_ink"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Right-side vertical controls, per the owner's mockup: settings,
         flash, photo ratio, compass on/off. -->
    <LinearLayout
        android:id="@+id/sideControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gpsChip">

        <ImageButton
            android:id="@+id/sideSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_side_btn"
            android:contentDescription="@string/settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/sideFlash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_side_btn"
            android:contentDescription="@string/flash"
            android:padding="10dp"
            android:src="@drawable/ic_flash"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/sideRatio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_side_btn"
            android:contentDescription="@string/photo_ratio"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="3:4" />

        <ImageButton
            android:id="@+id/sideCompass"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_side_btn"
            android:contentDescription="@string/compass"
            android:padding="10dp"
            android:src="@drawable/ic_row_compass"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- The live overlay: exactly what will be burned onto the photo,
         as stacked pills in the owner's mockup arrangement. -->
    <LinearLayout
        android:id="@+id/stampStack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintWidth_max="330dp">

        <LinearLayout
            android:id="@+id/pillDateTime"
            style="@style/StampPill">

            <ImageView
                style="@style/StampBadge"
                android:contentDescription="@null"
                android:backgroundTint="@color/badge_blue"
                android:src="@drawable/ic_row_calendar" />

            <TextView
                android:id="@+id/tvDateTime"
                style="@style/StampPillTextBold"
                tools:text="24/07/2026 11:45 AM" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillCoords"
            style="@style/StampPill">

            <ImageView
                style="@style/StampBadge"
                android:contentDescription="@null"
                android:backgroundTint="@color/badge_green"
                android:src="@drawable/ic_row_pin" />

            <TextView
                android:id="@+id/tvCoords"
                style="@style/StampPillText"
                tools:text="34.0522° N, 71.5375° E" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillAddress"
            style="@style/StampPill">

            <ImageView
                style="@style/StampBadge"
                android:contentDescription="@null"
                android:backgroundTint="@color/badge_indigo"
                android:src="@drawable/ic_row_home" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRegion"
                    style="@style/StampPillTextBold"
                    tools:text="Islamabad, Pakistan" />

                <TextView
                    android:id="@+id/tvExact"
                    style="@style/StampPillText"
                    android:textSize="11sp"
                    tools:text="F-6 Markaz, Islamabad 44000" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillAltitude"
            style="@style/StampPill">

            <ImageView
                style="@style/StampBadge"
                android:contentDescription="@null"
                android:backgroundTint="@color/badge_teal"
                android:src="@drawable/ic_row_mountain" />

            <TextView
                android:id="@+id/tvAltitude"
                style="@style/StampPillText"
                tools:text="Altitude: 540 m | Accuracy: 5 m" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillWeather"
            style="@style/StampPill">

            <ImageView
                style="@style/StampBadge"
                android:contentDescription="@null"
                android:backgroundTint="@color/badge_amber"
                android:src="@drawable/ic_row_sun" />

            <TextView
                android:id="@+id/tvWeather"
                style="@style/StampPillText"
                tools:text="Weather: 28°C, Sunny" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imgMap"
            android:layout_width="132dp"
            android:layout_height="84dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_map_thumb"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/pillCompass"
            style="@style/StampPill">

            <ImageView
                style="@style/StampBadge"
                android:contentDescription="@null"
                android:backgroundTint="@color/badge_teal"
                android:src="@drawable/ic_row_compass" />

            <TextView
                android:id="@+id/tvCompass"
                style="@style/StampPillText"
                tools:text="NE 45°" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillWatermark"
            style="@style/StampPill">

            <ImageView
                style="@style/StampBadge"
                android:contentDescription="@null"
                android:backgroundTint="@color/badge_slate"
                android:src="@drawable/ic_row_cam" />

            <TextView
                android:id="@+id/tvWatermark"
                style="@style/StampPillTextBold"
                tools:text="Captured by Roshan Camera" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/viewfinder_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintWidth_max="380dp">

        <TextView
            android:id="@+id/permissionMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/on_ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/permissionAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/accent_amber"
            android:textColor="@color/ink_text" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/chrome_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="28dp"
        android:paddingVertical="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/openGallery"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@color/chrome_bar"
                android:contentDescription="@string/gallery"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_gallery"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/gallery"
                android:textColor="@color/on_ink"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/shutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_shutter"
            android:contentDescription="@string/take_photo"
            android:src="@drawable/ic_shutter"
            app:tint="@color/viewfinder_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/openSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings"
                android:textColor="@color/on_ink"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
